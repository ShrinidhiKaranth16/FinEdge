{
  "info": {
    "name": "FinEdge - Postman Collection",
    "_postman_id": "b7d3f3d2-9f2a-4a6a-9b8f-1c2d3e4f5a6b",
    "description": "Basic Postman collection for FinEdge APIs (Member 1) — health check and user registration. Use {{baseUrl}} collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has status key\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('status');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sanath\",\n  \"email\": \"sanath@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 400/409 on validation/duplicate\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400, 409]);",
                  "});",
                  "",
                  "// If creation succeeded, assert response shape (no password returned)",
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.test(\"Response contains data object\", function () {",
                  "        pm.expect(json).to.have.property('data');",
                  "    });",
                  "    pm.test(\"Returned user has no password\", function () {",
                  "        pm.expect(json.data).to.not.have.property('password');",
                  "    });",
                  "}",
                  "",
                  "// Helpful log for manual testing",
                  "console.log('POST /users status:', pm.response.code);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
